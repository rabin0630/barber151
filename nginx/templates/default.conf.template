# nginxの起動時に${DOMAIN}が置き換えられ、/etc/nginx/conf.d/default.confになる

# パスごとのCache-Control
# /assets/はViteがファイル名にハッシュをつけるので、1年キャッシュしてよい
# それ以外(HTMLや/images/など)は同じ名前のまま中身が変わるので、使う前に毎回サーバーに確認させる(変わっていなければ304)
map $uri $cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";
    default     "no-cache";
}

# HTTP: 証明書の更新(certbot)に使い、それ以外はHTTPSに転送する
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: 画面を配信し、/api/だけバックエンドに転送する
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # locationの中にadd_headerを書くと、ここのadd_headerがそのlocationで全部消えるので、ヘッダーはここだけで付ける
    add_header Cache-Control $cache_control;

    root /usr/share/nginx/html;

    # バックエンドのルートは/menusなどで/apiがないので、末尾の/で/api/を外して転送する
    location /api/ {
        proxy_pass http://backend:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /bookingでもbooking.htmlを返す
    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}
